<Window x:Class="Finpulse.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FINPULSE | Finanzas estudiantiles"
        Width="1060" Height="690" MinWidth="850" MinHeight="640"
        UseLayoutRounding="True" SnapsToDevicePixels="True" WindowStartupLocation="CenterScreen" Background="{DynamicResource BackgroundBrush}" Foreground="White">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" Padding="42">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="FINPULSE" FontSize="31" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Text="Tu futuro financiero comienza hoy" FontSize="26"
                           FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,35,0,18"/>
                <TextBlock Text="Organiza tus ingresos y gastos, establece metas de ahorro y prepárate para proyectar tus finanzas a largo plazo."
                           TextWrapping="Wrap" LineHeight="25" FontSize="15" Foreground="{DynamicResource MutedBrush}"/>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12"
                        Padding="20" Margin="0,50,0,0">
                    <StackPanel>
                        <TextBlock Text="TU ESPACIO FINANCIERO" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Text="Registro e inicio de sesión" FontSize="15" Margin="0,9,0,5"/>
                        <TextBlock Text="Control · Ahorro · Proyección" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
        <Grid Grid.Column="1" Margin="55,35">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ConnectionInfo" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,15"
                               TextWrapping="Wrap"/>
                    <StackPanel x:Name="LoginPanel">
                        <TextBlock Text="Iniciar sesión" FontSize="29" FontWeight="Bold"/>
                        <TextBlock Text="Accede a tu espacio financiero" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,28"/>
                        <TextBlock Text="Correo electrónico" FontSize="13"/>
                        <TextBox x:Name="LoginEmail" AutomationProperties.Name="Correo electrónico" MaxLength="254"/>
                        <TextBlock Text="Contraseña" FontSize="13"/>
                        <PasswordBox x:Name="LoginPassword" AutomationProperties.Name="Contraseña" MaxLength="128"/>
                        <Button x:Name="LoginButton" Content="Ingresar" Click="Login_Click" Style="{StaticResource PrimaryButton}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,17,0,0">
                            <TextBlock Text="¿No tienes cuenta?" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                            <Button Content="Regístrate" Click="GoRegister_Click" Style="{StaticResource TextButton}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="RegisterPanel" Visibility="Collapsed">
                        <TextBlock Text="Crear una cuenta" FontSize="29" FontWeight="Bold"/>
                        <TextBlock Text="Regístrate para comenzar" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,20"/>
                        <TextBlock Text="Nombre completo" FontSize="13"/>
                        <TextBox x:Name="RegisterFullNameTextBox" AutomationProperties.Name="Nombre completo" MaxLength="120"/>
                        <TextBlock Text="Correo electrónico" FontSize="13"/>
                        <TextBox x:Name="RegisterEmail" AutomationProperties.Name="Correo de registro" MaxLength="254"/>
                        <TextBlock Text="Contraseña (12 a 128 caracteres)" FontSize="13"/>
                        <PasswordBox x:Name="RegisterPassword" AutomationProperties.Name="Contraseña de registro" MaxLength="128"/>
                        <TextBlock Text="Confirmar contraseña" FontSize="13"/>
                        <PasswordBox x:Name="ConfirmPassword" AutomationProperties.Name="Confirmar contraseña" MaxLength="128"/>
                        <Button x:Name="RegisterButton" Content="Crear cuenta" Click="Register_Click"
                                Style="{StaticResource PrimaryButton}"/>
                        <Button Content="Volver al inicio de sesión" Click="GoLogin_Click"
                                Style="{StaticResource TextButton}" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel x:Name="DashboardPanel" Visibility="Collapsed">
                        <TextBlock Text="Bienvenido a FINPULSE" FontSize="29" FontWeight="Bold"/>
                        <TextBlock x:Name="WelcomeName" Foreground="{DynamicResource AccentBrush}" FontSize="20" Margin="0,12,0,8"/>
                        <TextBlock x:Name="WelcomeEmail" Foreground="{DynamicResource MutedBrush}"/>
                        <Border Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="22" Margin="0,35,0,20">
                            <StackPanel>
                                <TextBlock Text="¡Autenticación completada!" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="Has iniciado sesión con Oracle. Sus módulos financieros están pendientes de integración; selecciona SQLite en la configuración para utilizar el desarrollo local."
                                           TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0" LineHeight="24"/>
                            </StackPanel>
                        </Border>
                        <Button Content="Cerrar sesión" Click="Logout_Click" Style="{StaticResource PrimaryButton}"/>
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Foreground="{DynamicResource WarningBrush}" FontSize="13"
                               Margin="0,18,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
