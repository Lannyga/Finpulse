<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Finpulse.Desktop.Views.GoalsView">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="270"/>
        </Grid.ColumnDefinitions>
        <Grid Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="180"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding AvailableText}" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
            <Grid Grid.Row="1">
                <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" AutomationProperties.Name="Registros financieros">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Meta" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Objetivo" Binding="{Binding Target, StringFormat=N2}" Width="110"/>
                        <DataGridTextColumn Header="Reservado" Binding="{Binding Saved, StringFormat=N2}" Width="100"/>
                        <DataGridTextColumn Header="% logrado" Binding="{Binding Percent, StringFormat=N1}" Width="90"/>
                        <DataGridTextColumn Header="Fecha objetivo" Binding="{Binding Deadline}" Width="115"/>
                        <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
            <TextBlock Grid.Row="2" Text="Aportes de la meta seleccionada" Style="{StaticResource Subheading}" Margin="0,16,0,12"/>
            <Grid Grid.Row="3">
                <DataGrid ItemsSource="{Binding Contributions}" SelectedItem="{Binding SelectedContribution}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" AutomationProperties.Name="Registros financieros">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding Date}" Width="*"/>
                        <DataGridTextColumn Header="Monto (Bs)" Binding="{Binding Amount, StringFormat=N2}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
            <WrapPanel Grid.Row="4" Margin="0,16,0,0">
                <StackPanel Margin="0,0,12,8">
                    <TextBlock Text="Aporte (Bs)" Style="{StaticResource MutedText}" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding ContributionAmount, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Aporte (Bs)"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,8">
                    <TextBlock Text="Fecha del aporte" Style="{StaticResource MutedText}" Margin="0,0,0,5"/>
                    <DatePicker SelectedDate="{Binding ContributionDate, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Fecha del aporte"/>
                </StackPanel>
                <Button Content="Guardar aporte" Command="{Binding ContributeCommand}" Style="{StaticResource PrimaryButton}" Margin="0,4,8,4"/>
                <Button Content="Nuevo aporte" Command="{Binding NewContributionCommand}" Style="{StaticResource SecondaryButton}" Margin="0,4,8,4"/>
                <Button Content="Eliminar aporte" Command="{Binding DeleteContributionCommand}" Style="{StaticResource SecondaryButton}" Margin="0,4,8,4"/>
            </WrapPanel>
        </Grid>
        <Border Grid.Column="1" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Button Content="Estimar plazo y ahorro requerido" Command="{Binding ProjectionCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,16"/>
                    <TextBlock Text="Nueva / editar meta" Style="{StaticResource Subheading}"/>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Nombre" Style="{StaticResource MutedText}" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" AutomationProperties.Name="Nombre"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Descripción" Style="{StaticResource MutedText}" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AutomationProperties.Name="Descripción"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Monto objetivo (Bs)" Style="{StaticResource MutedText}" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding EditAmount, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Monto objetivo (Bs)"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Fecha objetivo" Style="{StaticResource MutedText}" Margin="0,0,0,5"/>
                        <DatePicker SelectedDate="{Binding Deadline, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Fecha objetivo"/>
                    </StackPanel>
                    <Button Content="Guardar meta" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="0,4,8,4"/>
                    <Button Content="Nueva meta" Command="{Binding NewCommand}" Style="{StaticResource SecondaryButton}" Margin="0,4,8,4"/>
                    <Button Content="Eliminar meta" Command="{Binding DeleteCommand}" Style="{StaticResource SecondaryButton}" Margin="0,4,8,4"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
