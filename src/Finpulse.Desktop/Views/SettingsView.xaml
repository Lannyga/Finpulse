<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Finpulse.Desktop.Views.SettingsView">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Almacenamiento y configuración" Style="{StaticResource Subheading}"/>
                    <TextBlock Text="{Binding ProviderInfo}" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,16"/>
                    <TextBlock Text="{Binding Instructions}" TextWrapping="Wrap" Style="{StaticResource MutedText}"/>
                    <TextBlock Text="{Binding Warning, StringFormat=Umbral de aviso presupuestario: {0} %}" Margin="0,20,0,0"/>
                    <TextBlock Text="Edita BudgetWarningPercent en appsettings.json para cambiar el aviso (entre 0 y 100). El límite máximo es 100 %." TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,8"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="Privacidad local" Style="{StaticResource Subheading}"/>
                    <TextBlock Text="{Binding Privacy}" TextWrapping="Wrap" Style="{StaticResource MutedText}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
