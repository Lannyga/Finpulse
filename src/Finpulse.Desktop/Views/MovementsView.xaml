<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Finpulse.Desktop.Views.MovementsView">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>
        <Grid Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <WrapPanel>
                <StackPanel Margin="0,0,12,8">
                    <TextBlock Text="Desde" Style="{StaticResource MutedText}" Margin="0,0,0,5"/>
                    <DatePicker SelectedDate="{Binding From, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Desde"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,8">
                    <TextBlock Text="Hasta" Style="{StaticResource MutedText}" Margin="0,0,0,5"/>
                    <DatePicker SelectedDate="{Binding To, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Hasta"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,8">
                    <TextBlock Text="Categoría" Style="{StaticResource MutedText}" Margin="0,0,0,5"/>
                    <ComboBox SelectedItem="{Binding FilterCategory, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding FilterCategories}" AutomationProperties.Name="Categoría"/>
                </StackPanel>
                <Button Content="Filtrar" Command="{Binding FilterCommand}" Style="{StaticResource SecondaryButton}" Margin="0,4,8,4"/>
            </WrapPanel>
            <TextBlock Grid.Row="1" Text="{Binding ListInfo}" Style="{StaticResource MutedText}" Margin="0,8,0,16"/>
            <Grid Grid.Row="2">
                <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" AutomationProperties.Name="Registros financieros">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding Date}" Width="110"/>
                        <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="140"/>
                        <DataGridTextColumn Header="Monto (Bs)" Binding="{Binding Amount, StringFormat=N2}" Width="110"/>
                        <DataGridTextColumn Header="Descripción" Binding="{Binding Description}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
        <Border Grid.Column="1" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Nuevo / editar movimiento" Style="{StaticResource Subheading}"/>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Monto (Bs, sin miles)" Style="{StaticResource MutedText}" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding EditAmount, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Monto (Bs, sin miles)"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Categoría" Style="{StaticResource MutedText}" Margin="0,0,0,5"/>
                        <ComboBox SelectedItem="{Binding Category, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding Categories}" AutomationProperties.Name="Categoría"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Fecha" Style="{StaticResource MutedText}" Margin="0,0,0,5"/>
                        <DatePicker SelectedDate="{Binding EditDate, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Fecha"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Descripción (opcional)" Style="{StaticResource MutedText}" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AutomationProperties.Name="Descripción (opcional)"/>
                    </StackPanel>
                    <Button Content="Guardar movimiento" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="0,4,8,4"/>
                    <Button Content="Limpiar / nuevo" Command="{Binding NewCommand}" Style="{StaticResource SecondaryButton}" Margin="0,4,8,4"/>
                    <Button Content="Eliminar seleccionado" Command="{Binding DeleteCommand}" Style="{StaticResource SecondaryButton}" Margin="0,4,8,4"/>
                    <TextBlock Text="Selecciona una fila para editar. Los cambios se guardan al pulsar Guardar." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,16,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
