<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Finpulse.Desktop.Views.ReportsView">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <WrapPanel>
            <StackPanel Margin="0,0,12,8">
                <TextBlock Text="Desde" Style="{StaticResource MutedText}" Margin="0,0,0,5"/>
                <DatePicker SelectedDate="{Binding From, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Desde"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,8">
                <TextBlock Text="Hasta" Style="{StaticResource MutedText}" Margin="0,0,0,5"/>
                <DatePicker SelectedDate="{Binding To, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Hasta"/>
            </StackPanel>
            <Button Content="Consultar" Command="{Binding FilterCommand}" Style="{StaticResource SecondaryButton}" Margin="0,4,8,4"/>
            <Button Content="Exportar CSV" Command="{Binding ExportCommand}" Style="{StaticResource PrimaryButton}" Margin="0,4,8,4"/>
        </WrapPanel>
        <TextBlock Grid.Row="1" Text="{Binding Totals}" FontSize="18" Margin="0,12,0,20"/>
        <Grid Grid.Row="2">
            <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" AutomationProperties.Name="Registros financieros">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tipo" Binding="{Binding Kind, Converter={StaticResource MovementKindConverter}}" Width="90"/>
                    <DataGridTextColumn Header="Fecha" Binding="{Binding Date}" Width="110"/>
                    <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="140"/>
                    <DataGridTextColumn Header="Monto (Bs)" Binding="{Binding Amount, StringFormat=N2}" Width="110"/>
                    <DataGridTextColumn Header="Descripción" Binding="{Binding Description}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
