<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime" xmlns:c="clr-namespace:Finpulse.Desktop.Controls" x:Class="Finpulse.Desktop.Views.DashboardView">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <DockPanel Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Agregar movimiento" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,12,0"/>
                    <Button Content="Simular mi futuro" Command="{Binding ProjectCommand}" Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
                <TextBlock Text="{Binding Period}" FontSize="20"/>
            </DockPanel>
            <UniformGrid Columns="3">
                <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Saldo actual" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="{Binding Summary.Balance, StringFormat=Bs {0:N2}}" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Trabajo del mes" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="{Binding Salary, StringFormat=Bs {0:N2}}" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource BlueBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Ingresos del mes" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="{Binding Summary.Income, StringFormat=Bs {0:N2}}" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Gastos del mes" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="{Binding Summary.Expense, StringFormat=Bs {0:N2}}" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource BlueBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Ahorro del mes" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="{Binding Summary.Savings, StringFormat=Bs {0:N2}}" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Tasa de ahorro" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="{Binding Summary.SavingsRate, StringFormat={}{0:N1} %}" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
            <Border Style="{StaticResource Card}" Margin="0,8,0,20">
                <StackPanel>
                    <TextBlock Text="Mi evolución económica" Style="{StaticResource Subheading}"/>
                    <WrapPanel>
                        <StackPanel Width="160" Margin="0,0,16,8">
                            <TextBlock Text="Meses visibles" Style="{StaticResource MutedText}"/>
                            <ComboBox ItemsSource="{Binding Ranges}" SelectedItem="{Binding Range}" AutomationProperties.Name="Meses del historial" Margin="0,0,0,4" MinHeight="34"/>
                        </StackPanel>
                        <StackPanel Width="240">
                            <TextBlock Text="Comparación" Style="{StaticResource MutedText}"/>
                            <ComboBox ItemsSource="{Binding Metrics}" SelectedItem="{Binding Metric}" AutomationProperties.Name="Series históricas" Margin="0,0,0,4" MinHeight="34"/>
                        </StackPanel>
                    </WrapPanel>
                    <c:FinancialLineChart Series="{Binding Chart}" Height="250" AutomationProperties.Name="Evolución histórica en bolivianos"/>
                    <TextBlock Text="{Binding Trend}" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
                    <TextBlock Text="Trabajo incluye únicamente ingresos clasificados como Trabajo. El ahorro mensual puede ser negativo." TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <TextBlock Text="Historial mensual · valores registrados en Bs" Style="{StaticResource Subheading}"/>
            <DataGrid ItemsSource="{Binding History}" Height="240" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" AutomationProperties.Name="Tabla financiera">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mes" Binding="{Binding Label}" Width="100"/>
                    <DataGridTextColumn Header="Ingresos" Binding="{Binding Income, StringFormat=N2}" Width="*"/>
                    <DataGridTextColumn Header="Trabajo" Binding="{Binding Salary, StringFormat=N2}" Width="*"/>
                    <DataGridTextColumn Header="Gastos" Binding="{Binding Expense, StringFormat=N2}" Width="*"/>
                    <DataGridTextColumn Header="Ahorro" Binding="{Binding Savings, StringFormat=N2}" Width="*"/>
                    <DataGridTextColumn Header="Saldo" Binding="{Binding Balance, StringFormat=N2}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="Gastos por categoría del mes" Style="{StaticResource Subheading}" Margin="0,20,0,12"/>
            <DataGrid ItemsSource="{Binding Categories}" Height="170" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" AutomationProperties.Name="Tabla financiera">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="*"/>
                    <DataGridTextColumn Header="Gasto (Bs)" Binding="{Binding Amount, StringFormat=N2}" Width="*"/>
                    <DataGridTextColumn Header="Porcentaje (%)" Binding="{Binding Percent, StringFormat=N2}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="{Binding EmptyMessage}" Style="{StaticResource Subheading}" Margin="0,20,0,12"/>
            <DataGrid ItemsSource="{Binding Recent}" Height="220" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" AutomationProperties.Name="Tabla financiera">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Fecha" Binding="{Binding Date}" Width="110"/>
                    <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="140"/>
                    <DataGridTextColumn Header="Monto (Bs)" Binding="{Binding Amount, StringFormat=N2}" Width="120"/>
                    <DataGridTextColumn Header="Descripción" Binding="{Binding Description}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="Observaciones basadas en tus registros" Style="{StaticResource Subheading}" Margin="0,20,0,12"/>
            <DataGrid ItemsSource="{Binding Advice}" Height="200" RowHeight="{x:Static sys:Double.NaN}" MinRowHeight="64" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True" AutomationProperties.Name="Fundamentos del análisis">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Observación" Binding="{Binding Title}" Width="170"/>
                    <DataGridTemplateColumn Header="Fundamento numérico" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="4"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
