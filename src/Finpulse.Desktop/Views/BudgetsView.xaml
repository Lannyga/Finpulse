<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Finpulse.Desktop.Views.BudgetsView">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Planifica tus gastos del mes" Style="{StaticResource Subheading}"/>
                <WrapPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Mes (AAAA-MM)" Style="{StaticResource MutedText}" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Month, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Mes (AAAA-MM)"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Categoría" Style="{StaticResource MutedText}" Margin="0,0,0,5"/>
                        <ComboBox SelectedItem="{Binding Category, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding Categories}" AutomationProperties.Name="Categoría"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Monto asignado (Bs)" Style="{StaticResource MutedText}" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding EditAmount, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Monto asignado (Bs)"/>
                    </StackPanel>
                    <Button Content="Guardar" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="0,4,8,4"/>
                    <Button Content="Nuevo" Command="{Binding NewCommand}" Style="{StaticResource SecondaryButton}" Margin="0,4,8,4"/>
                    <Button Content="Eliminar" Command="{Binding DeleteCommand}" Style="{StaticResource SecondaryButton}" Margin="0,4,8,4"/>
                </WrapPanel>
                <TextBlock Text="El presupuesto General incluye todos los gastos. Los límites por categoría se evalúan por separado." Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1">
            <DataGrid RowStyle="{StaticResource BudgetRowStyle}" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" AutomationProperties.Name="Registros financieros">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mes" Binding="{Binding Month}" Width="95"/>
                    <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="130"/>
                    <DataGridTextColumn Header="Asignado" Binding="{Binding Amount, StringFormat=N2}" Width="90"/>
                    <DataGridTextColumn Header="Gastado" Binding="{Binding Spent, StringFormat=N2}" Width="90"/>
                    <DataGridTextColumn Header="Disponible" Binding="{Binding Available, StringFormat=N2}" Width="95"/>
                    <DataGridTextColumn Header="% usado" Binding="{Binding Percent, StringFormat=N1}" Width="85"/>
                    <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
