<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Finpulse.Desktop.ViewModels" xmlns:v="clr-namespace:Finpulse.Desktop.Views" x:Class="Finpulse.Desktop.WorkspaceWindow" Title="FINPULSE | Mi espacio financiero" Width="1320" Height="860" MinWidth="1000" MinHeight="720" WindowStartupLocation="CenterScreen" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <v:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MovementsViewModel}">
            <v:MovementsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BudgetsViewModel}">
            <v:BudgetsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GoalsViewModel}">
            <v:GoalsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProjectionsViewModel}">
            <v:ProjectionsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <v:ReportsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <v:SettingsView/>
        </DataTemplate>
    </Window.Resources>
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource PanelBrush}" Padding="20,28">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="FINPULSE" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="27"/>
                    <TextBlock Text="FINANZAS ESTUDIANTILES" Style="{StaticResource MutedText}" FontSize="10" Margin="0,4,0,36"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="{Binding UserName}" TextWrapping="Wrap" Margin="0,12"/>
                    <Button Content="Cerrar sesión" Command="{Binding LogoutCommand}" Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
                <ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding Section}" Background="{DynamicResource PanelBrush}" BorderThickness="0" Foreground="{DynamicResource TextBrush}" AutomationProperties.Name="Secciones financieras">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="14"/>
                            <Setter Property="Margin" Value="0,3"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Nav" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Nav" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Nav" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter TargetName="Nav" Property="BorderThickness" Value="1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,24">
                <Button DockPanel.Dock="Right" Content="Actualizar" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}"/>
                <StackPanel>
                    <TextBlock Text="{Binding Section}" FontSize="28" FontWeight="SemiBold"/>
                    <TextBlock Text="Tu dinero, con una dirección clara." Style="{StaticResource MutedText}" Margin="0,5,0,0"/>
                </StackPanel>
            </DockPanel>
            <ContentControl Grid.Row="1" Content="{Binding Page}"/>
            <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,16,0,0" AutomationProperties.LiveSetting="Polite"/>
        </Grid>
    </Grid>
</Window>
