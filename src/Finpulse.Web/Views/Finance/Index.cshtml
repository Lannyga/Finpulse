@model PortalSnapshot
@{
    ViewData["Title"] = "Resumen";
    var today = PortalFinance.Today;
    var summary = FinanceRules.Summarize(Model.Data, today);
    var history = FinanceRules.History(Model.Data, today);
    var chart = JsonSerializer.Serialize(new { labels = history.Select(x => x.Label), series = new[] {
        new { label = "Recibiste", values = history.Select(x => x.Income) },
        new { label = "Gastaste", values = history.Select(x => x.Expense) }
    } });
    string Money(decimal amount) => amount.ToString("N2", CultureInfo.GetCultureInfo("es-BO"));
}
<div class="page-heading"><div><span class="eyebrow">@today.ToString("MMMM yyyy", CultureInfo.GetCultureInfo("es-BO"))</span><h1>Así va tu dinero<span class="accent">.</span></h1><p class="muted">Hola, @User.Identity?.Name. ¿Cómo va tu mes?</p></div><a class="btn btn-primary" asp-action="Movements">+ Anotar movimiento</a></div>
<div class="bento">
    <section class="panel balance-card"><span class="eyebrow">TU SALDO</span><div class="money"><span>Bs</span> @Money(summary.Balance)</div><p>Lo que tienes según tus registros.</p><div class="balance-bottom"><span>Libre para usar<strong>Bs @Money(summary.Available)</strong></span><span>En tus metas<strong>Bs @Money(summary.Balance - summary.Available)</strong></span></div></section>
    <section class="panel metric"><span class="metric-icon" aria-hidden="true">↙</span><span class="eyebrow">ENTRÓ ESTE MES</span><strong>Bs @Money(summary.Income)</strong><span class="small muted">Mesada, beca, trabajo y otros</span></section>
    <section class="panel metric"><span class="metric-icon expense-icon" aria-hidden="true">↗</span><span class="eyebrow">GASTASTE ESTE MES</span><strong>Bs @Money(summary.Expense)</strong><span class="small muted">Lo que usaste en tu día a día</span></section>
    <section class="panel chart-card"><div class="section-heading"><h2>Tu mes a mes</h2><span class="pill">Últimos 6 meses</span></div><div class="chart-container"><canvas data-fin-chart="@chart" aria-label="Ingresos y gastos por mes. Los valores están en la tabla desplegable." role="img"></canvas></div><details><summary>Ver los números</summary><div class="table-responsive"><table class="table"><caption>Totales mensuales en bolivianos</caption><thead><tr><th>Mes</th><th>Recibiste</th><th>Gastaste</th></tr></thead><tbody>@foreach (var month in history) { <tr><th scope="row">@month.Label</th><td>Bs @Money(month.Income)</td><td>Bs @Money(month.Expense)</td></tr> }</tbody></table></div></details></section>
    <section class="panel insight-card"><span class="eyebrow">UN CONSEJO PARA TI</span><h2>Una idea para hoy</h2>
        @if (Model.Data.Movements.Count == 0) { <p class="muted">Empieza anotando cuánto tienes. Después registra tus gastos, incluso los pequeños.</p> }
        else if (summary.Expense > summary.Income) { <p class="muted">Este mes gastaste Bs @Money(summary.Expense - summary.Income) más de lo que recibiste. Revisa tus últimos gastos antes de comprar algo más.</p> }
        else { <p class="muted">Si te sobra un poco, guárdalo en una meta: materiales, una computadora o tu próximo plan.</p> }
        <a class="text-link" asp-action="Goals">Ver mis metas ↗</a>
    </section>
    <section class="panel full-width"><div class="section-heading"><h2>Tus últimos movimientos</h2><a class="text-link" asp-action="Movements">Ver todos ↗</a></div>
        @if (Model.Data.Movements.Count == 0) { <div class="empty"><h3>Aquí empieza tu registro.</h3><p>Anota tu mesada, una beca o tu primer gasto.</p></div> }
        @foreach (var movement in Model.Data.Movements.Take(4)) {
            <div class="transaction"><span class="transaction-symbol" aria-hidden="true">@(movement.Kind == MovementKind.Income ? "↙" : "↗")</span><div><strong>@movement.Category</strong><span class="muted small d-block">@movement.Description · @movement.Date.ToString("dd/MM/yyyy")</span></div><strong class="@(movement.Kind == MovementKind.Income ? "accent" : "")">@(movement.Kind == MovementKind.Income ? "+" : "−") Bs @Money(movement.Amount)</strong></div>
        }
    </section>
</div>
