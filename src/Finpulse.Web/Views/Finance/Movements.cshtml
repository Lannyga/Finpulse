@model PortalSnapshot
@{ ViewData["Title"] = "Movimientos"; var f = ViewBag.Form as FinanceForm ?? new() { Date = PortalFinance.Today.ToDateTime(TimeOnly.MinValue) }; }
<div class="page-heading"><div><span class="eyebrow">CADA BOLIVIANO CUENTA</span><h1>Ingresos y gastos</h1><p class="muted">Registra lo que entra y lo que sale. Todo empieza por verlo claro.</p></div><a class="btn btn-secondary" asp-action="Export">Descargar CSV ↗</a></div>
<partial name="_Errors" />
<div class="form-layout"><section class="panel"><h2>Nuevo movimiento</h2><form asp-action="Save" method="post" class="stack"><input type="hidden" name="module" value="movements" /><input type="hidden" name="RequestKey" value="@f.RequestKey" /><input type="hidden" name="Id" value="@f.Id" /><input type="hidden" name="Revision" value="@f.Revision" />
<label for="Kind">Tipo</label><select id="Kind" name="Kind" data-category-type><option value="0" selected="@(f.Kind == 0)">Ingreso</option><option value="1" selected="@(f.Kind == 1)">Gasto</option></select>
<label for="CategoryId">Categoría</label><select id="CategoryId" name="CategoryId" required>@foreach (var c in Model.Categories) { <option value="@c.Id" data-kind="@c.Kind" selected="@(f.CategoryId == c.Id)">@c.Name · @(c.Kind == 0 ? "Ingreso" : "Gasto")</option> }</select>
<label for="Amount">Monto (Bs)</label><input id="Amount" name="Amount" type="number" min="0.01" max="1000000000" step="0.01" value="@(f.Amount == 0 ? "" : f.Amount.ToString(CultureInfo.InvariantCulture))" required />
<label for="Date">Fecha</label><input id="Date" name="Date" type="date" value="@f.Date.ToString("yyyy-MM-dd")" max="@PortalFinance.Today.ToString("yyyy-MM-dd")" required />
<label for="Description">Descripción (opcional)</label><input id="Description" name="Description" value="@f.Description" maxlength="500" /><button class="btn btn-primary">Guardar movimiento</button><a asp-action="Movements">Nuevo / cancelar edición</a></form></section>
<section class="panel"><div class="section-heading"><h2>Tu historial</h2><span class="pill">@Model.Data.Movements.Count registros</span></div>
@if (Model.Data.Movements.Count == 0) { <div class="empty"><h3>Tu primer paso está aquí.</h3><p>Completa el formulario para empezar tu historial.</p></div> }
<div class="table-responsive"><table class="table"><caption>Movimientos registrados · montos en BOB</caption><thead><tr><th>Fecha</th><th>Detalle</th><th>Tipo</th><th>Monto</th><th>Acción</th></tr></thead><tbody>@foreach (var m in Model.Data.Movements) { <tr><td>@m.Date.ToString("dd/MM/yy")</td><td><strong>@m.Category</strong><span class="muted small d-block">@m.Description</span></td><td>@(m.Kind == MovementKind.Income ? "Ingreso" : "Gasto")</td><td class="numeric">Bs @m.Amount.ToString("N2")</td><td><a asp-action="Edit" asp-route-module="movements" asp-route-id="@m.Id" class="btn btn-quiet">Editar</a><form asp-action="Delete" method="post" data-confirm="¿Eliminar este movimiento?"><input type="hidden" name="module" value="movements" /><input type="hidden" name="id" value="@m.Id" /><button class="btn btn-quiet" aria-label="Eliminar movimiento @m.Category del @m.Date">Eliminar</button></form></td></tr> }</tbody></table></div></section></div>

