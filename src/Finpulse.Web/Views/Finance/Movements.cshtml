@model PortalSnapshot
@{
    ViewData["Title"] = "Movimientos";
    var form = ViewBag.Form as FinanceForm ?? new() { Date = PortalFinance.Today.ToDateTime(TimeOnly.MinValue) };
}
<div class="page-heading"><div><span class="eyebrow">TU DÍA A DÍA</span><h1>Ingresos y gastos</h1><p class="muted">Tu mesada, un almuerzo, un pasaje… Anótalo aquí.</p></div></div>
<div class="form-layout">
    <section class="panel"><h2>@(form.Id == 0 ? "Anotar movimiento" : "Editar movimiento")</h2>
        <form asp-action="Save" method="post" class="stack">
            <input type="hidden" name="module" value="movements" />
            <input type="hidden" name="RequestKey" value="@form.RequestKey" />
            <input type="hidden" name="Id" value="@form.Id" />
            <input type="hidden" name="Revision" value="@form.Revision" />
            <label for="Kind">Tipo</label>
            <select id="Kind" name="Kind" data-category-type><option value="0" selected="@(form.Kind == 0)">Ingreso</option><option value="1" selected="@(form.Kind == 1)">Gasto</option></select>
            <label for="CategoryId">Categoría</label>
            <select id="CategoryId" name="CategoryId" required>
                @foreach (var category in Model.Categories) {
                    <option value="@category.Id" data-kind="@category.Kind" selected="@(form.CategoryId == category.Id)">@category.Name</option>
                }
            </select>
            <label for="Amount">Monto (Bs)</label>
            <input id="Amount" name="Amount" type="number" min="0.01" max="1000000000" step="0.01" value="@(form.Amount == 0 ? "" : form.Amount.ToString(CultureInfo.InvariantCulture))" required />
            <label for="Date">Fecha</label>
            <input id="Date" name="Date" type="date" value="@form.Date.ToString("yyyy-MM-dd")" max="@PortalFinance.Today.ToString("yyyy-MM-dd")" required />
            <label for="Description">Nota (opcional)</label>
            <input id="Description" name="Description" value="@form.Description" maxlength="500" />
            <button class="btn btn-primary">Guardar movimiento</button>
            @if (form.Id > 0) { <a asp-action="Movements">Cancelar edición</a> }
        </form>
    </section>
    <section class="panel">
        <div class="section-heading"><h2>Tu historial</h2><span class="pill">@Model.Data.Movements.Count registros</span></div>
        @if (Model.Data.Movements.Count == 0) {
            <div class="empty"><h3>Tu primer paso está aquí.</h3><p>Completa el formulario para empezar tu historial.</p></div>
        } else {
            <div class="table-responsive"><table class="table movement-table">
                <caption>Lo que recibiste y gastaste · montos en bolivianos</caption>
                <thead><tr><th>Fecha</th><th>Detalle</th><th>Tipo</th><th>Monto</th><th>Acción</th></tr></thead>
                <tbody>
                @foreach (var movement in Model.Data.Movements) {
                    <tr>
                        <td data-label="Fecha">@movement.Date.ToString("dd/MM/yy")</td>
                        <td data-label="Detalle"><div><strong>@movement.Category</strong><span class="muted small d-block">@movement.Description</span></div></td>
                        <td data-label="Tipo">@(movement.Kind == MovementKind.Income ? "Ingreso" : "Gasto")</td>
                        <td data-label="Monto" class="numeric">Bs @movement.Amount.ToString("N2", CultureInfo.GetCultureInfo("es-BO"))</td>
                        <td>
                            <a asp-action="Edit" asp-route-module="movements" asp-route-id="@movement.Id" class="btn btn-quiet">Editar</a>
                            <form asp-action="Delete" method="post" data-confirm="¿Eliminar este movimiento?">
                                <input type="hidden" name="module" value="movements" /><input type="hidden" name="id" value="@movement.Id" />
                                <button class="btn btn-quiet" aria-label="Eliminar movimiento @movement.Category del @movement.Date">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table></div>
        }
    </section>
</div>
