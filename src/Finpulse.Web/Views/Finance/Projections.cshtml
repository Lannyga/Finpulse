@model PortalSnapshot
@{
    ViewData["Title"] = "Proyecciones"; var analysis = new FinancialAnalysisService(); var baseline = analysis.Baseline(Model.Data, PortalFinance.Today);
    var summary = FinanceRules.Summarize(Model.Data, PortalFinance.Today);
    var f = ViewBag.Form as ScenarioForm ?? new() { Capital = summary.Balance, Income = baseline.Income, Expense = baseline.Expense };
}
<div class="page-heading"><div><span class="eyebrow">MIRA UN POCO MÁS LEJOS</span><h1>Tu futuro, en perspectiva.</h1><p class="muted">Explora escenarios de 1, 3, 5 y 10 años. Los supuestos nunca modifican tus movimientos reales.</p></div></div><partial name="_Errors" />
<section class="panel"><div class="section-heading"><div><h2>Construye un escenario</h2><p class="muted small">@baseline.Explanation</p></div><span class="pill">Simulación · BOB</span></div>
<form asp-action="Scenario" method="post" class="scenario-form"><input type="hidden" name="RequestKey" value="@f.RequestKey" />
<div><label for="Name">Nombre del escenario</label><input id="Name" name="Name" value="@f.Name" required maxlength="100" /></div>
<div><label for="Years">Horizonte</label><select id="Years" name="Years">@foreach (int y in new[] { 1,3,5,10 }) { <option value="@y" selected="@(y == f.Years)">@y @(y == 1 ? "año" : "años")</option> }</select></div>
@foreach (var field in new[] { ("Capital", "Capital inicial (Bs)", f.Capital), ("Income", "Ingreso mensual (Bs)", f.Income), ("Expense", "Gasto mensual (Bs)", f.Expense), ("IncomeChange", "Variación anual del ingreso (%)", f.IncomeChange), ("ExpenseChange", "Variación anual del gasto (%)", f.ExpenseChange), ("Inflation", "Inflación efectiva anual (%)", f.Inflation), ("AnnualReturn", "Rendimiento efectivo anual (%)", f.AnnualReturn), ("ContributionChange", "Variación anual del aporte (%)", f.ContributionChange) }) { <div><label for="@field.Item1">@field.Item2</label><input id="@field.Item1" name="@field.Item1" type="number" step="0.0001" value="@field.Item3.ToString(CultureInfo.InvariantCulture)" required /></div> }
<div><label for="Contribution">Aporte mensual (Bs, opcional)</label><input id="Contribution" name="Contribution" type="number" step="0.01" min="0" max="1000000000" value="@f.Contribution?.ToString(CultureInfo.InvariantCulture)" placeholder="Todo el excedente" /></div>
<div class="scenario-submit"><button class="btn btn-primary">Calcular y guardar ↗</button></div>
</form><p class="small muted mt-3">Capitaliza al final de cada mes. El aporte se limita al excedente; un déficit reduce el capital. Tasas ingresadas por ti, sin valores de mercado precargados. Cálculos en decimal con redondeo final a centavos.</p></section>
@if (Model.Scenarios.Count == 0) { <section class="panel empty mt-4"><h2>Una decisión hoy. Más claridad mañana.</h2><p>Introduce tus supuestos y compara el resultado de tus escenarios.</p></section> }
@foreach (var s in Model.Scenarios) {
    var points = new MonthlyProjectionEngine().Calculate(PortalFinance.Request(s)); var last = points[^1];
    var chart = JsonSerializer.Serialize(new { labels = points.Select(x => x.Date.ToString("MM/yy")), series = new[] { new { label = "Saldo nominal", values = points.Select(x => x.Balance) }, new { label = "Saldo real", values = points.Select(x => x.RealBalance) } } });
    <section class="panel mt-4"><div class="section-heading"><div><span class="eyebrow">SIMULACIÓN A @s.Years AÑOS · DESDE @s.Start.ToString("dd/MM/yyyy")</span><h2>@s.Name</h2></div><a class="text-link" asp-action="Export" asp-route-scenarioId="@s.Id">Descargar detalle CSV ↗</a></div><div class="projection-totals"><div><span class="muted">Saldo nominal</span><strong>Bs @last.Balance.ToString("N2")</strong></div><div><span class="muted">Poder adquisitivo inicial</span><strong>Bs @last.RealBalance.ToString("N2")</strong></div><div><span class="muted">Rendimiento / inflación anual</span><strong>@s.AnnualReturn % / @s.Inflation %</strong></div></div><div class="chart-container"><canvas data-fin-chart="@chart" role="img" aria-label="Proyección nominal y real de @s.Name. Los valores están en el detalle anual y CSV."></canvas></div><details><summary>Supuestos y resultados anuales</summary><p class="small muted">Ingreso inicial: Bs @s.Income · Gasto: Bs @s.Expense · Capital: Bs @s.Capital · Variación anual ingreso/gasto/aporte: @s.IncomeChange % / @s.ExpenseChange % / @s.ContributionChange % · Aporte: @(s.Contribution?.ToString("N2") ?? "todo el excedente")</p><div class="table-responsive"><table class="table"><thead><tr><th>Año</th><th>Saldo nominal (Bs)</th><th>Saldo real (Bs)</th></tr></thead><tbody>@foreach (var p in points.Where(x => x.Month % 12 == 0)) { <tr><td>@(p.Month / 12)</td><td>@p.Balance.ToString("N2")</td><td>@p.RealBalance.ToString("N2")</td></tr> }</tbody></table></div></details>
    @foreach (var g in Model.Data.Goals) { var saved = Model.Data.Contributions.Where(x => x.GoalId == g.Id).Sum(x => x.Amount); var e = analysis.EstimateGoal(g, saved, PortalFinance.Request(s)); <p class="small"><strong>@g.Name:</strong> @e.Status · @(e.MonthsNeeded is int months ? $"{months} meses" : "Sin fecha estimada") · Requerido: @(e.RequiredMonthly.HasValue ? $"Bs {e.RequiredMonthly:N2}/mes" : e.RequiredNote). Cada meta se simula por separado; no representa asignaciones simultáneas.</p> }
    <form asp-action="Delete" method="post" data-confirm="¿Eliminar este escenario?"><input type="hidden" name="module" value="scenarios" /><input type="hidden" name="id" value="@s.Id" /><button class="btn btn-quiet">Eliminar escenario</button></form></section>
}
