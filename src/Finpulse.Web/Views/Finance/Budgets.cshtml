@model PortalSnapshot
@{ ViewData["Title"] = "Presupuestos"; var f = ViewBag.Form as FinanceForm ?? new(); }
<div class="page-heading"><div><span class="eyebrow">ESPACIO PARA LO IMPORTANTE</span><h1>Gasta con intención.</h1><p class="muted">Define límites mensuales y sigue tu avance por categoría.</p></div></div><partial name="_Errors" />
<div class="form-layout"><section class="panel"><h2>Nuevo presupuesto</h2><form asp-action="Save" method="post" class="stack"><input type="hidden" name="module" value="budgets" /><input type="hidden" name="RequestKey" value="@f.RequestKey" /><input type="hidden" name="Id" value="@f.Id" /><input type="hidden" name="Revision" value="@f.Revision" /><label for="Month">Mes</label><input id="Month" name="Month" type="month" value="@f.Month" required /><label for="CategoryId">Categoría</label><select id="CategoryId" name="CategoryId"><option value="">General · todos los gastos</option>@foreach (var c in Model.Categories.Where(x => x.Kind == 1)) { <option value="@c.Id" selected="@(c.Id == f.CategoryId)">@c.Name</option> }</select><label for="Amount">Límite mensual (Bs)</label><input id="Amount" name="Amount" type="number" min="0.01" step="0.01" max="1000000000" value="@(f.Amount == 0 ? "" : f.Amount.ToString(CultureInfo.InvariantCulture))" required /><button class="btn btn-primary">Guardar presupuesto</button><a asp-action="Budgets">Nuevo / cancelar edición</a></form><p class="small muted mt-3">El presupuesto general resume todos los gastos; no se suma a los límites por categoría.</p></section>
<div class="card-list">@if (Model.Data.Budgets.Count == 0) { <section class="panel empty"><h2>Un plan para tu mes.</h2><p>Crea un presupuesto y transforma tus límites en decisiones claras.</p></section> }
@foreach (var b in Model.Data.Budgets.OrderByDescending(x => x.Month)) { var u = FinanceRules.Evaluate(b, Model.Data.Movements.Where(x => x.Date <= PortalFinance.Today), Model.Warning); <section class="panel"><div class="section-heading"><div><span class="eyebrow">@b.Month</span><h2>@b.Category</h2></div><span class="pill">@u.Percent.ToString("N1") % usado</span></div><progress max="100" value="@Math.Min(u.Percent,100).ToString(CultureInfo.InvariantCulture)" aria-label="Uso de presupuesto @b.Category"></progress><div class="section-heading"><span>Bs @u.Spent.ToString("N2") <span class="muted">de @b.Amount.ToString("N2")</span></span><strong>@u.Status</strong></div><p class="small muted">Restante: Bs @u.Available.ToString("N2") · Aviso desde @Model.Warning %</p><form asp-action="Delete" method="post" data-confirm="¿Eliminar este presupuesto?"><input type="hidden" name="module" value="budgets" /><input type="hidden" name="id" value="@b.Id" /><a asp-action="Edit" asp-route-module="budgets" asp-route-id="@b.Id" class="btn btn-quiet">Editar</a><button class="btn btn-quiet">Eliminar presupuesto</button></form></section> }</div></div>

