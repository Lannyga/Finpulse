@model PortalSnapshot
@{ ViewData["Title"] = "Reportes"; var analysis = new FinancialAnalysisService(); var history = analysis.History(Model.Data, PortalFinance.Today, 12); var summary = FinanceRules.Summarize(Model.Data, PortalFinance.Today); var advice = analysis.Recommendations(Model.Data, PortalFinance.Today, summary.Income, summary.Expense, []); }
<div class="page-heading"><div><span class="eyebrow">ENTIENDE TU RECORRIDO</span><h1>Los números cuentan tu historia.</h1><p class="muted">Historial de los últimos 12 meses y recomendaciones con fundamento.</p></div><a class="btn btn-primary" asp-action="Export">Descargar movimientos CSV ↗</a></div>
<section class="panel"><h2>Tu año en cifras</h2><div class="table-responsive"><table class="table"><caption>Bolivianos (BOB). Ahorro = ingresos − gastos. Saldo acumulado incluye movimientos anteriores.</caption><thead><tr><th>Mes</th><th>Ingresos</th><th>Trabajo</th><th>Gastos</th><th>Ahorro</th><th>Saldo acumulado</th></tr></thead><tbody>@foreach (var h in history) { <tr><td>@h.Label</td><td>@h.Income.ToString("N2")</td><td>@h.Salary.ToString("N2")</td><td>@h.Expense.ToString("N2")</td><td>@h.Savings.ToString("N2")</td><td>@h.Balance.ToString("N2")</td></tr> }</tbody></table></div></section>
<div class="two-column mt-4"><section class="panel"><h2>Gastos del mes por categoría</h2>@foreach (var g in Model.Data.Movements.Where(x => x.Kind == MovementKind.Expense && x.Date.Year == PortalFinance.Today.Year && x.Date.Month == PortalFinance.Today.Month).GroupBy(x => x.Category)) { <div class="transaction"><span>@g.Key</span><strong>Bs @g.Sum(x => x.Amount).ToString("N2")</strong></div> }@if (summary.Expense == 0) { <p class="muted">Todavía no tienes gastos registrados este mes.</p> }</section><section class="panel insight-card"><span class="eyebrow">DECISIONES CON CONTEXTO</span><h2>Recomendaciones</h2>@if (advice.Count == 0) { <p class="muted">No hay alertas con los datos actuales. Revisa que hayas registrado todos tus movimientos.</p> }@foreach (var a in advice) { <h3>@a.Title</h3><p class="muted small">@a.Detail</p> }</section></div>
