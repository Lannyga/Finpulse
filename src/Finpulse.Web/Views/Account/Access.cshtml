@model Credentials
@{
    var register = ViewContext.RouteData.Values["action"]?.ToString() == "Register";
    var action = register ? "Register" : "Login";
    ViewData["Title"] = register ? "Crea tu cuenta" : "Entra a tu espacio";
}
<div class="auth-grid">
    <section class="auth-story"><a class="brand" href="/"><img src="~/mark.svg" alt="" width="48" height="48" />FINPULSE.</a><span class="eyebrow">PARA TU VIDA DE ESTUDIANTE</span><h1>Tu dinero.<br />Tus planes.<br /><em>Más claros.</em></h1><p>Anota lo que recibes, mira en qué gastas y ahorra para lo que necesitas.</p><div class="auth-art" aria-hidden="true"><span></span><span></span><span></span><span></span></div><p class="small">Un paso a la vez, sin complicarte.</p></section>
    <section class="auth-card"><span class="eyebrow">BIENVENIDO A FINPULSE</span><h2>@ViewData["Title"]</h2><p class="muted">@(register ? "Solo necesitas un usuario y una contraseña." : "Tu dinero y tus metas, en un solo lugar.")</p>
        <form method="post" asp-action="@action" class="stack">
            <label asp-for="Username">Usuario</label><input asp-for="Username" autocomplete="username" required pattern="[a-zA-Z0-9_.-]{3,40}" maxlength="40" /><span asp-validation-for="Username"></span>
            <label asp-for="Password">Contraseña</label><input asp-for="Password" type="password" autocomplete="@(register ? "new-password" : "current-password")" required minlength="6" maxlength="128" /><span asp-validation-for="Password"></span>
            @if (register) { <label asp-for="Confirm">Repite tu contraseña</label><input asp-for="Confirm" type="password" autocomplete="new-password" required minlength="6" maxlength="128" /><p class="small muted">Usa de 6 a 128 caracteres. Guarda tu contraseña en un lugar seguro.</p> }
            <button class="btn btn-primary">@(register ? "Crear cuenta" : "Entrar") <span aria-hidden="true">↗</span></button>
        </form>
        <div class="auth-links"><a asp-action="@(register ? "Login" : "Register")">@(register ? "Ya tengo una cuenta" : "Crear una cuenta")</a></div>
    </section>
</div>
